# --- Sanity (sanity.io/manage) -------------------------------------------
# Leave PROJECT_ID empty to serve the built-in copy of the site (content/pages).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token: used by the import script and to save contact-form enquiries.
SANITY_API_WRITE_TOKEN=
# Shared secret for the "publish → refresh site" webhook (/api/revalidate).
SANITY_REVALIDATE_SECRET=

# --- Enquiry emails (optional, resend.com) --------------------------------
RESEND_API_KEY=
LEAD_EMAIL=revivaskinandsurgery@gmail.com
LEAD_EMAIL_FROM=
